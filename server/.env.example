# Copy to .env and fill in real values. Never commit the real .env file.

# Where live bottle/recipe/metrics state lives, kept outside the git
# checkout so auto-deploy's `git pull` never overwrites it. Leave unset
# for local dev (files sit next to index.js, as committed in the repo).
JAMES_DATA_DIR=/home/pi/james-data

JAMES_DASHBOARD_URL=https://james-dashboard-api.pages.dev
JAMES_REPORT_TOKEN=

# For the AI "surprise me" drink generator (server/ai.js)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
