# Copy to .env and fill in real values. Never commit the real .env file.

# Where live bottle/recipe/metrics state lives, kept outside the git
# checkout so auto-deploy's `git pull` never overwrites it. Leave unset
# for local dev (files sit next to index.js, as committed in the repo).
JAMES_DATA_DIR=/home/pi/james-data

# Cloud config sync (server/cloud-sync.js <-> cloud/ Worker). The token is
# the Worker's DEVICE_TOKEN secret. Unset = sync is skipped entirely.
JAMES_CLOUD_URL=https://james-cloud.<account>.workers.dev
JAMES_CLOUD_DEVICE_TOKEN=
# Optional: cycle interval for `cloud-sync.js --daemon` (cron mode ignores it),
# HTTP timeout, and where the local drink server answers /api/version.
#JAMES_CLOUD_POLL_MS=60000
#JAMES_CLOUD_TIMEOUT_MS=10000
#JAMES_SERVER_URL=http://localhost:8000

# For the AI "surprise me" drink generator (server/ai.js)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Shot mode ("5 viinaa"): the belt isn't driven by this software yet. Set
# JAMES_BELT_CMD to a shell command that moves the belt one glass along, and
# JAMES_BELT_MS to how long that takes (default 3000). Unset = only logged.
#JAMES_BELT_CMD=
#JAMES_BELT_MS=3000
