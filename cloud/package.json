{
  "name": "james-cloud",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Worker: James device config (versioned) + stats ingest + config UI",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply james-cloud --local",
    "migrate:remote": "wrangler d1 migrations apply james-cloud --remote",
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\""
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
